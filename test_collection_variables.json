{
  "info": {
    "name": "Variables Test"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://httpbin.org",
      "type": "string"
    },
    {
      "key": "greeting",
      "value": "Hello",
      "type": "string"
    },
    {
      "key": "name",
      "value": "runbook-tui",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "Bearer super-secret-token",
      "type": "secret"
    }
  ],
  "item": [
    {
      "name": "Get IP via variable",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/get",
        "header": []
      }
    },
    {
      "name": "Post JSON with variables",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/post",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"message\":\"{{greeting}} {{name}}!\"}"
        }
      }
    },
    {
      "name": "Get with secret header",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/bearer",
        "header": [
          {
            "key": "Authorization",
            "value": "{{apiKey}}"
          }
        ]
      }
    }
  ]
}
